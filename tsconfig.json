{
  "compilerOptions": {
    "allowJs": false,
    "esModuleInterop": true,
    "forceConsistentCasingInFileNames": true,
    "jsx": "react-jsx",
    "lib": ["DOM", "DOM.Iterable", "ES2023"],
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "noEmit": true,
    "resolveJsonModule": true,
    "skipLibCheck": true,
    "strict": false,
    "target": "ES2022",
    "paths": {
      "@/*": ["./src/*"]
    }
  },
  "include": ["src", "tests", "rsbuild.config.ts", "rsbuild.dev-proxy.ts", "rslint.config.ts", "rstest.config.ts"]
}
