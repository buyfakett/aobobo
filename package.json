{
  "name": "aobobo",
  "version": "2.0.1",
  "author": "buyfakett",
  "type": "module",
  "packageManager": "pnpm@12.16.1",
  "engines": {
    "node": "^20.19.0 || >=22.12.0"
  },
  "scripts": {
    "dev": "rsbuild dev",
    "build": "rsbuild build",
    "build:analyze": "cross-env RSDOCTOR=true rsbuild build",
    "preview": "rsbuild preview",
    "lint": "rslint .",
    "lint:ci": "rslint . --format github --max-warnings 0 --no-color",
    "lint:fix": "rslint --fix",
    "typecheck": "tsc --noEmit",
    "test": "rstest run",
    "test:watch": "rstest watch",
    "test:coverage": "rstest run --coverage",
    "test:ci": "rstest run --coverage"
  },
  "dependencies": {
    "axios": "^1.21.1",
    "d3-geo": "^3.1.2",
    "dayjs": "^1.11.23",
    "echarts": "^6.1.0",
    "echarts-for-react": "^3.0.6",
    "echarts-gl": "^2.1.0",
    "flag-icons": "^7.6.0",
    "font-logos": "^1.4.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "react-router-dom": "^7.18.5",
    "remixicon": "^4.9.1"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/buyfakett/aobobo"
  },
  "devDependencies": {
    "@rsbuild/core": "^2.3.2",
    "@rsbuild/plugin-react": "^2.1.1",
    "@rsbuild/plugin-tailwindcss": "^2.0.3",
    "@rsdoctor/core": "^2.0.3",
    "@rslint/core": "^0.10.1",
    "@rstest/core": "^0.12.6",
    "@rstest/coverage-v8": "^0.12.6",
    "@testing-library/react": "^16.3.3",
    "@types/node": "^26.6.6",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "cross-env": "^10.1.0",
    "dotenv": "^18.0.10",
    "happy-dom": "^20.14.6",
    "tailwindcss": "^4.3.5",
    "typescript": "^7.0.2"
  },
  "optionalDependencies": {
    "@rslint/native-linux-x64-gnu": "0.10.0"
  }
}
